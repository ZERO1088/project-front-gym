.page {
  padding: 14rpx 14rpx 24rpx;
}

.date-bar {
  margin-bottom: 12rpx;
}

.date-btn,
.date-picker {
  min-height: 66rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  border-radius: 16rpx;
  border: 1rpx solid #e4e8ef;
  background: #ffffff;
  color: #374151;
}

.date-btn {
  padding: 0 18rpx;
}

.date-picker {
  color: #2563eb;
  font-weight: 600;
}

.overview-card {
  margin-bottom: 12rpx;
  border-radius: 18rpx;
}

.overview-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 10rpx;
}

.overview-title-wrap {
  min-width: 0;
}

.overview-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #111827;
  display: flex;
  align-items: center;
}

.blue-dot {
  display: inline-block;
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #3b82f6;
  margin-right: 10rpx;
}

.overview-subtitle {
  margin-top: 6rpx;
  color: #94a3b8;
  font-size: 20rpx;
}

.overview-weather {
  max-width: 280rpx;
}

.overview-weather-text {
  text-align: right;
  color: #94a3b8;
  font-size: 20rpx;
  line-height: 1.5;
}

.overview-stats {
  margin-top: 12rpx;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10rpx;
}

.overview-stat {
  background: #f8fafc;
  border: 1rpx solid #e6ebf2;
  border-radius: 14rpx;
  padding: 10rpx 10rpx 8rpx;
}

.overview-stat-label {
  color: #9ca3af;
  font-size: 20rpx;
}

.overview-stat-value {
  margin-top: 6rpx;
  color: #111827;
  font-size: 44rpx;
  line-height: 1;
  font-weight: 700;
}

.overview-stat-icon {
  margin-top: 6rpx;
  text-align: right;
  color: #60a5fa;
  font-size: 20rpx;
}

.list-card {
  border-radius: 18rpx;
  margin-bottom: 12rpx;
}

.list-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.list-title {
  display: flex;
  align-items: center;
  font-size: 30rpx;
  font-weight: 700;
  color: #111827;
}

.list-subtitle {
  font-size: 22rpx;
  color: #9ca3af;
}

.swipe-wrap {
  position: relative;
  margin-top: 12rpx;
  overflow: hidden;
  border-radius: 18rpx;
}

.swipe-actions {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  width: 204rpx;
  display: flex;
}

.swipe-btn {
  flex: 1;
  margin: 0;
  border-radius: 0;
  color: #fff;
  font-size: 24rpx;
}

.swipe-btn--cancel {
  background: #f59e0b;
}

.swipe-btn--delete {
  background: #ef4444;
}

.course-card {
  background: #fff;
  border: 1rpx solid #e8edf4;
  border-radius: 18rpx;
  padding: 18rpx;
  transition: transform 0.16s ease;
}

.course-card--open {
  transform: translateX(-204rpx);
}

.course-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 10rpx;
}

.course-title-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.course-color-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
}

.course-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #111827;
}

.course-meta,
.course-summary,
.course-remark {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #6b7280;
}

.student-row {
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid #edf1f7;
  display: flex;
  justify-content: space-between;
  gap: 12rpx;
}

.student-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #111827;
}

.student-sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #6b7280;
}

.student-side {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
}

.share-btn {
  margin: 0;
  height: 58rpx;
  line-height: 58rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  border: 0;
  background: #3b82f6;
  color: #fff;
  font-size: 22rpx;
}

.empty-card.no-shadow {
  box-shadow: none;
  border: 1rpx solid #eef2f7;
  border-radius: 16rpx;
}

.empty-state {
  padding: 24rpx 8rpx 10rpx;
  text-align: center;
}

.empty-illustration {
  width: 280rpx;
  height: 176rpx;
  margin: 0 auto 14rpx;
  position: relative;
}

.ill-bg {
  position: absolute;
  left: 50%;
  bottom: 10rpx;
  transform: translateX(-50%);
  width: 248rpx;
  height: 108rpx;
  border-radius: 999rpx;
  background: radial-gradient(ellipse at center, #eef4ff 0%, #f8fbff 70%, rgba(248, 251, 255, 0) 100%);
}

.ill-dot {
  position: absolute;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #dbe7ff;
}

.ill-dot--left {
  left: 44rpx;
  top: 86rpx;
}

.ill-dot--right {
  right: 50rpx;
  top: 80rpx;
}

.calendar-illus {
  position: absolute;
  left: 50%;
  top: 28rpx;
  transform: translateX(-50%);
  width: 112rpx;
  height: 112rpx;
  border-radius: 22rpx;
  background: #ffffff;
  border: 1rpx solid #e7edf7;
  box-shadow: 0 10rpx 24rpx rgba(59, 130, 246, 0.12);
}

.calendar-illus-top {
  height: 30rpx;
  border-radius: 22rpx 22rpx 0 0;
  background: linear-gradient(90deg, #eaf2ff 0%, #f4f8ff 100%);
  border-bottom: 1rpx solid #e7edf7;
}

.calendar-ring {
  position: absolute;
  top: -7rpx;
  width: 8rpx;
  height: 14rpx;
  border-radius: 999rpx;
  background: #9fb7e9;
}

.calendar-ring--left {
  left: 24rpx;
}

.calendar-ring--right {
  right: 24rpx;
}

.calendar-grid {
  padding: 14rpx 14rpx 0;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 7rpx;
}

.calendar-grid-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 3rpx;
  background: #9bb8f7;
  margin: 0 auto;
}

.ill-bubble {
  position: absolute;
  right: 56rpx;
  top: 104rpx;
  width: 48rpx;
  height: 34rpx;
  border-radius: 12rpx;
  background: linear-gradient(135deg, #2d7dff 0%, #3f89ff 100%);
  box-shadow: 0 8rpx 16rpx rgba(59, 130, 246, 0.28);
}

.ill-bubble::before {
  content: '';
  position: absolute;
  left: 12rpx;
  top: 14rpx;
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: #ffffff;
  box-shadow: 12rpx 0 0 #ffffff, 24rpx 0 0 #ffffff;
}

.empty-title {
  font-size: 38rpx;
  line-height: 1.2;
  color: #111827;
  font-weight: 700;
}

.empty-subtitle {
  margin-top: 12rpx;
  font-size: 22rpx;
  line-height: 1.65;
  color: #9ca3af;
}

.empty-action {
  margin: 16rpx auto 0;
  width: 360rpx;
  height: 70rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 700;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  letter-spacing: 0;
  word-spacing: 0;
  text-indent: 0;
  box-shadow: 0 12rpx 24rpx rgba(59, 130, 246, 0.3);
  background: linear-gradient(135deg, #2d7dff 0%, #3f89ff 100%);
}

.btn-text-fix {
  display: block;
  line-height: 1;
  letter-spacing: 0;
  word-spacing: 0;
  white-space: nowrap;
}

.btn-arrow {
  font-size: 24rpx;
  line-height: 1;
  opacity: 0.96;
}
