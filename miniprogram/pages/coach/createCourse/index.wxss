.page {
  padding: 24rpx;
}

.form-stack {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.field-group {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.field-label {
  color: #7d7d82;
  font-size: 24rpx;
}

.picker-pill {
  padding: 24rpx 26rpx;
  border-radius: 24rpx;
  background: linear-gradient(180deg, rgba(250, 250, 252, 1), rgba(244, 244, 247, 0.96));
  border: 1rpx solid rgba(17, 17, 17, 0.05);
  color: #111111;
  font-size: 28rpx;
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.8);
}

.time-picker-row {
  display: flex;
  gap: 16rpx;
}

.time-picker-row picker {
  flex: 1;
}

.picker-pill--half {
  text-align: center;
}

.field-hint {
  color: #8b8b8b;
  font-size: 24rpx;
  margin-top: -4rpx;
}

.color-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.color-chip {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.86);
  border: 1rpx solid rgba(17, 17, 17, 0.05);
}

.color-chip--active {
  border-color: rgba(17, 17, 17, 0.16);
  box-shadow: 0 12rpx 28rpx rgba(17, 17, 17, 0.06);
}

.color-dot {
  width: 22rpx;
  height: 22rpx;
  border-radius: 50%;
}

.color-name {
  color: #111111;
  font-size: 24rpx;
}

.hint,
.student-meta {
  color: #8b8b8b;
  font-size: 24rpx;
  margin-top: 16rpx;
}

.student-select-card,
.completion-card {
  margin-top: 20rpx;
}

.section-title,
.student-name {
  color: #111111;
  font-size: 28rpx;
  font-weight: 600;
}

.student-item {
  border: 1rpx solid rgba(17, 17, 17, 0.05);
  border-radius: 24rpx;
  padding: 22rpx;
  margin-top: 16rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.98), rgba(246, 246, 248, 0.9));
}

.student-item--active {
  border-color: rgba(17, 17, 17, 0.16);
  background: linear-gradient(180deg, rgba(245, 247, 255, 0.98), rgba(240, 243, 250, 0.92));
  box-shadow: 0 10rpx 26rpx rgba(17, 17, 17, 0.05);
}

.student-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.student-badge {
  font-size: 22rpx;
  color: #4a90e2;
}
