.student-page {
  padding-bottom: 44rpx;
}

.segment-card {
  display: flex;
  gap: 12rpx;
  padding: 10rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.9);
  box-shadow: 0 12rpx 32rpx rgba(17, 17, 17, 0.05);
  margin-bottom: 20rpx;
}

.segment-item {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 999rpx;
  color: #6f6f73;
  font-size: 26rpx;
}

.segment-item--active {
  background: linear-gradient(135deg, #111111, #2d2d31);
  color: #ffffff;
  box-shadow: 0 12rpx 24rpx rgba(17, 17, 17, 0.14);
}

.calendar-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.month-btn {
  min-width: 120rpx;
  margin: 0;
}

.calendar-month {
  color: #111111;
  font-size: 32rpx;
  font-weight: 700;
}

.week-row,
.calendar-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 14rpx;
}

.week-label {
  text-align: center;
  color: #9a9aa1;
  font-size: 22rpx;
}

.calendar-cell {
  display: flex;
  justify-content: center;
}

.calendar-cell--empty {
  min-height: 76rpx;
}

.calendar-day {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #5f5f65;
  background: rgba(245, 245, 247, 0.95);
  font-size: 26rpx;
}

.calendar-day--highlighted {
  background: linear-gradient(135deg, #4a90e2, #6ba5f3);
  color: #ffffff;
  box-shadow: 0 12rpx 24rpx rgba(74, 144, 226, 0.24);
}

.calendar-day--active {
  transform: scale(1.06);
  border: 2rpx solid rgba(17, 17, 17, 0.12);
}

.course-line {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 18rpx;
  padding: 20rpx 0;
  border-top: 1rpx solid rgba(17, 17, 17, 0.06);
}

.course-line:first-of-type {
  border-top: 0;
  padding-top: 8rpx;
}

.course-time {
  color: #111111;
  font-size: 28rpx;
  font-weight: 600;
}

.course-meta,
.section-caption,
.empty-state-text {
  color: #8c8c91;
  font-size: 24rpx;
  margin-top: 8rpx;
}

.course-status {
  border-radius: 999rpx;
  padding: 10rpx 18rpx;
  background: rgba(237, 244, 255, 0.95);
  color: #2563eb;
  font-size: 23rpx;
}

.empty-state {
  text-align: center;
}
