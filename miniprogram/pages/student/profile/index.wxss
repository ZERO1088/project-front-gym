.student-page {
  padding-bottom: 44rpx;
}

.segment-card {
  display: flex;
  gap: 12rpx;
  padding: 10rpx;
  border-radius: 999rpx;
  background: #ffffff;
  border: 1rpx solid #e8eaee;
  margin-bottom: 20rpx;
}

.segment-item {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 999rpx;
  color: #6b7280;
  font-size: 26rpx;
}

.segment-item--active {
  background: #3b82f6;
  color: #ffffff;
}

.profile-card {
  align-items: center;
  text-align: center;
}

.avatar-badge {
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  background: #3b82f6;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 42rpx;
  font-weight: 700;
  margin: 0 auto 18rpx;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  margin: 20rpx 0;
}

.stat-card {
  background: #ffffff;
  border-radius: 20rpx;
  border: 1rpx solid #e8eaee;
  padding: 20rpx;
  text-align: center;
}

.stat-label {
  color: #6b7280;
  font-size: 22rpx;
}

.stat-value {
  margin-top: 10rpx;
  color: #111827;
  font-size: 36rpx;
  font-weight: 700;
}

.more-section {
  margin-top: 12rpx;
}

.action-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
  padding-top: 14rpx;
}

.action-title {
  color: #111827;
  font-size: 28rpx;
  font-weight: 700;
}

.action-subtitle {
  margin-top: 8rpx;
  color: #6b7280;
  font-size: 24rpx;
  line-height: 1.6;
}

.action-arrow {
  color: #9ca3af;
  font-size: 30rpx;
}

.reset-btn {
  width: 100%;
  margin-top: 14rpx;
}

.empty-state {
  text-align: center;
}
