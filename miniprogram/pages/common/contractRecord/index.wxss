.page {
  padding: 24rpx;
}

.contract-card {
  margin-top: 14rpx;
}

.field-block {
  margin-top: 14rpx;
}

.field-block:first-child {
  margin-top: 0;
}

.field-label {
  font-size: 24rpx;
  color: #6b7280;
  margin-bottom: 10rpx;
}

.picker-value {
  min-height: 82rpx;
  border: 1rpx solid #e5e7eb;
  border-radius: 18rpx;
  background: #f9fafb;
  padding: 0 20rpx;
  display: flex;
  align-items: center;
  color: #111827;
  font-size: 26rpx;
}

.photo-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10rpx;
}

.photo-item {
  position: relative;
  border-radius: 14rpx;
  overflow: hidden;
  border: 1rpx solid #e5e7eb;
  background: #f3f4f6;
  aspect-ratio: 1 / 1;
}

.photo-img {
  width: 100%;
  height: 100%;
  display: block;
}

.photo-remove {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  background: rgba(17, 24, 39, 0.72);
  color: #ffffff;
  line-height: 34rpx;
  text-align: center;
  font-size: 24rpx;
}

.photo-add {
  border: 1rpx dashed #cbd5e1;
  border-radius: 14rpx;
  background: #f8fafc;
  min-height: 200rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.photo-add-icon {
  font-size: 42rpx;
  color: #3b82f6;
  line-height: 1;
}

.photo-add-text {
  font-size: 22rpx;
  color: #6b7280;
}

.remark-input {
  width: 100%;
  min-height: 200rpx;
  box-sizing: border-box;
  border: 1rpx solid #e5e7eb;
  border-radius: 18rpx;
  background: #f9fafb;
  padding: 16rpx 18rpx;
  font-size: 26rpx;
  color: #111827;
}

.updated-time {
  margin-top: 14rpx;
  font-size: 22rpx;
  color: #6b7280;
}

.save-btn {
  margin-top: 16rpx;
}

.empty-block {
  margin-top: 14rpx;
  text-align: center;
}

.empty-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #111827;
}

.empty-subtitle {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #6b7280;
}
