/* ========= Global Design Tokens (Step 1) =========
Primary: #3B82F6
Success: #22C55E
Warning: #F59E0B
Danger:  #EF4444
Neutral: #9CA3AF
================================================== */

page {
  background: #f5f6f8;
  color: #111827;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
  font-size: 24rpx;
  line-height: 1.45;
}

.page-shell {
  padding: 24rpx 24rpx 36rpx;
}

.card,
.section-card,
.hero-card {
  background: #ffffff;
  border: 1rpx solid #e8eaee;
  border-radius: 28rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 20rpx rgba(17, 24, 39, 0.04);
}

.hero-card {
  padding: 30rpx;
}

.hero-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #111827;
  letter-spacing: 0.2rpx;
}

.hero-subtitle {
  font-size: 24rpx;
  color: #6b7280;
  margin-top: 8rpx;
  line-height: 1.7;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #111827;
  margin-bottom: 8rpx;
}

.section-caption,
.hero-note,
.time-cell-hint,
.student-sub,
.action-subtitle,
.field-hint {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #6b7280;
  line-height: 1.6;
}

.btn,
button[type='primary'],
.btn-primary {
  border-radius: 999rpx;
  background: #3b82f6;
  color: #ffffff;
  border: 0;
  box-shadow: 0 10rpx 20rpx rgba(59, 130, 246, 0.24);
}

button {
  border-radius: 999rpx;
}

.ghost-btn,
.btn-secondary {
  border-radius: 999rpx;
  background: #ffffff;
  color: #111827;
  border: 1rpx solid #d7dce3;
}

.btn-danger {
  border-radius: 999rpx;
  background: #ef4444;
  color: #ffffff;
  border: 0;
}

.detail-stack {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.detail-line {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #edf0f4;
}

.detail-line:last-child {
  border-bottom: 0;
  padding-bottom: 0;
}

.detail-label {
  color: #6b7280;
  font-size: 24rpx;
}

.detail-value {
  color: #111827;
  font-size: 26rpx;
  text-align: right;
  flex: 1;
}

.confirm-actions {
  display: flex;
  gap: 12rpx;
  margin-top: 20rpx;
}

.confirm-actions button {
  flex: 1;
}

.form-card {
  background: #ffffff;
  border: 1rpx solid #e8eaee;
  border-radius: 24rpx;
  padding: 24rpx;
}

.form-stack {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.field-input,
.field-textarea {
  width: 100%;
  box-sizing: border-box;
  color: #111827;
  font-size: 28rpx;
  background: #f9fafb;
  border: 1rpx solid #e5e7eb;
  border-radius: 20rpx;
}

.field-input {
  height: 82rpx;
  line-height: 82rpx;
  padding: 0 22rpx;
}

.field-textarea {
  min-height: 220rpx;
  padding: 18rpx 22rpx;
}

.primary-action {
  margin-top: 20rpx;
}

.empty-card {
  background: #ffffff;
  border: 1rpx solid #e8eaee;
  border-radius: 24rpx;
  padding: 30rpx 24rpx;
  text-align: center;
  color: #6b7280;
}

.date-bar,
.calendar-bar,
.segment-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.date-btn,
.date-picker,
.launch-skip {
  padding: 16rpx 20rpx;
  border-radius: 999rpx;
  background: #ffffff;
  border: 1rpx solid #dbe0e7;
  color: #111827;
  font-size: 26rpx;
}

.date-picker,
.calendar-title {
  flex: 1;
  text-align: center;
  font-weight: 600;
}

.week-row {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 10rpx;
  margin-bottom: 16rpx;
}

.week-item {
  text-align: center;
  padding: 12rpx 8rpx;
  border-radius: 16rpx;
  color: #6b7280;
  background: #f3f4f6;
  border: 1rpx solid #e5e7eb;
}

.week-item--active {
  color: #ffffff;
  background: #3b82f6;
  border-color: #3b82f6;
  font-weight: 700;
}

.time-grid,
.calendar-grid {
  display: grid;
  gap: 12rpx;
}

.time-grid {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.calendar-grid {
  grid-template-columns: repeat(7, minmax(0, 1fr));
}

.time-cell,
.calendar-day,
.student-picker,
.course-card,
.segment-item,
.action-item {
  background: #ffffff;
  border: 1rpx solid #e8eaee;
  border-radius: 20rpx;
}

.time-cell {
  padding: 20rpx;
}

.time-cell-title,
.calendar-day-number,
.student-name,
.action-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #111827;
}

.color-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
}

.color-chip {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx;
  border-radius: 18rpx;
  background: #ffffff;
  border: 1rpx solid #e5e7eb;
}

.color-chip--active {
  border-color: #3b82f6;
  background: #eff6ff;
}

.color-dot,
.calendar-day-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.student-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 20rpx 22rpx;
  margin-top: 10rpx;
}

.student-picker--active,
.student-card--new {
  border-color: #3b82f6;
  background: #eff6ff;
}

.student-mark {
  color: #3b82f6;
  font-weight: 700;
  font-size: 24rpx;
}

.student-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
  padding-bottom: 14rpx;
}

.student-arrow {
  color: #9ca3af;
  font-size: 24rpx;
}

.action-row {
  display: flex;
  gap: 12rpx;
  margin-top: 18rpx;
}

.action-row button {
  flex: 1;
}

.calendar-day {
  min-height: 92rpx;
  padding: 14rpx 8rpx;
  text-align: center;
}

.calendar-day--empty {
  background: transparent;
  border: 0;
}

.calendar-day--active {
  background: #3b82f6;
  border-color: #3b82f6;
}

.calendar-day--active .calendar-day-number,
.calendar-day--active .calendar-day-dot {
  color: #ffffff;
  background: #ffffff;
}

.calendar-day--marked {
  border-color: #bfdbfe;
}

.calendar-day-dot {
  margin: 8rpx auto 0;
  background: #3b82f6;
}

.profile-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.profile-copy {
  flex: 1;
}

.status-tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 38rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  line-height: 1;
  font-weight: 600;
}

.status-pending {
  color: #b45309;
  background: #fffbeb;
  border: 1rpx solid #fde68a;
}

.status-accepted,
.status-confirmed,
.status-completed {
  color: #166534;
  background: #f0fdf4;
  border: 1rpx solid #86efac;
}

.status-available,
.status-open {
  color: #1d4ed8;
  background: #eff6ff;
  border: 1rpx solid #93c5fd;
}

.status-cancelled,
.status-empty,
.status-muted {
  color: #6b7280;
  background: #f3f4f6;
  border: 1rpx solid #e5e7eb;
}

.launch-page {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  padding: 40rpx;
  background: #f5f6f8;
}

.launch-orb {
  width: 156rpx;
  height: 156rpx;
  border-radius: 50%;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 28rpx;
  border: 1rpx solid #e8eaee;
  box-shadow: 0 10rpx 22rpx rgba(17, 24, 39, 0.06);
}

.launch-symbol {
  font-size: 80rpx;
  line-height: 1;
  font-weight: 300;
  color: #3b82f6;
}

.launch-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #111827;
}

.launch-subtitle,
.launch-caption {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #6b7280;
  text-align: center;
  line-height: 1.7;
}

.launch-skip {
  margin-top: 34rpx;
}
